{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...all].js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/booking", "destination": "/Frontend/workspaces/customer-ticket-booking.html" },
    { "source": "/movies", "destination": "/Frontend/workspaces/customer-ticket-booking.html" },
    { "source": "/shows", "destination": "/Frontend/workspaces/customer-ticket-booking.html" },
    { "source": "/saas", "destination": "/Frontend/saas-website.html" },
    { "source": "/saas-website", "destination": "/Frontend/saas-website.html" },
    { "source": "/website", "destination": "/Frontend/saas-website.html" },
    { "source": "/portal", "destination": "/Frontend/client-portal.html" },
    { "source": "/client-portal", "destination": "/Frontend/client-portal.html" },
    { "source": "/admin", "destination": "/Frontend/super-admin-portal.html" },
    { "source": "/super-admin", "destination": "/Frontend/super-admin-portal.html" },
    { "source": "/checkout", "destination": "/Frontend/checkout.html" },
    { "source": "/login", "destination": "/Frontend/index.html" },
    { "source": "/signin", "destination": "/Frontend/index.html" },
    { "source": "/erp", "destination": "/Frontend/index.html" },
    { "source": "/manager", "destination": "/Frontend/workspaces/city_lite_cinema_erp_command_center_role_login.html" },
    { "source": "/counter", "destination": "/Frontend/workspaces/city_lite_cinema_erp_multi_counter_role_login.html" },
    { "source": "/food", "destination": "/Frontend/workspaces/city_lite_f_b_counter_pos_role_login.html" },
    { "source": "/favicon.ico", "destination": "/Frontend/favicon.svg" },
    { "source": "/favicon.svg", "destination": "/Frontend/favicon.svg" },
    { "source": "/royal-cinema-logo.svg", "destination": "/Frontend/royal-cinema-logo.svg" },
    { "source": "/lucide.min.js", "destination": "/Frontend/lucide.min.js" },
    { "source": "/cinema-hall.jpg", "destination": "/Frontend/cinema-hall.jpg" },
    { "source": "/cinema-login-hero.jpg", "destination": "/Frontend/cinema-login-hero.jpg" },
    { "source": "/robots.txt", "destination": "/Frontend/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/Frontend/sitemap.xml" },
    { "source": "/", "destination": "/Frontend/index.html" },
    { "source": "/(.*)", "destination": "/Frontend/$1" }
  ]
}
